PROJECT_ROOT=.
CONFIG_FILE=configs/config.yaml
LOG_LEVEL=INFO
DATASET_URL=https://www.kaggle.com/api/v1/datasets/download/mlg-ulb/creditcardfraud

# Security — CHANGE THESE before any shared or production use
JWT_SECRET=replace-with-at-least-32-character-random-secret-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# API
API_HOST=127.0.0.1
API_PORT=8000
APP_ENVIRONMENT=development

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./fraud_intelligence.db
# DATABASE_URL=postgresql://fraud_user:fraud_pass@localhost:5432/fraud_intelligence

# MLflow (optional — file-based tracking for local dev)
MLFLOW_TRACKING_URI=file:///./mlruns
